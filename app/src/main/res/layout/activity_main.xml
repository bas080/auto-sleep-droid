<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/main_content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="0dp">

                <LinearLayout
                    android:id="@+id/header_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/app_title_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Timer Section -->
                <TextView
                    android:id="@+id/header_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="4dp"
                    android:text="@string/heading_timer"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Enable Sleep Timer -->
                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/row_enable_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/label_enable_timer"
                    app:rowDescription="@string/desc_enable_timer"
                    app:rowType="toggle"
                    app:switchId="@+id/switch_enable_timer" />

                <!-- Timer Duration -->
                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/input_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/label_duration"
                    app:rowDescription="@string/desc_duration"
                    app:rowType="value"
                    app:valueId="@+id/text_duration_value" />

                <!-- Alarm Section -->
                <TextView
                    android:id="@+id/header_alarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="4dp"
                    android:text="@string/heading_alarm"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Wake-Up Goal Section -->
                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/row_enable_goal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/label_wake_up_goal"
                    app:rowDescription="@string/desc_wake_up_goal"
                    app:rowType="toggle"
                    app:switchId="@+id/switch_enable_goal" />

                <LinearLayout
                    android:id="@+id/goal_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.bas080.autosleepdroid.SettingRowView
                        android:id="@+id/btn_target_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowTitle="@string/label_target_time"
                        app:rowDescription="@string/desc_target_time"
                        app:rowType="value"
                        app:valueId="@+id/text_target_time_value" />

                    <com.bas080.autosleepdroid.SettingRowView
                        android:id="@+id/btn_current_wake_time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowTitle="@string/label_current_wake_time"
                        app:rowDescription="@string/desc_current_wake_time"
                        app:rowType="value"
                        app:valueId="@+id/text_current_wake_time_value" />

                    <com.bas080.autosleepdroid.SettingRowView
                        android:id="@+id/input_min_sleep"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowTitle="@string/label_min_sleep"
                        app:rowDescription="@string/desc_min_sleep"
                        app:rowType="value"
                        app:valueId="@+id/text_min_sleep_value" />

                </LinearLayout>

                <!-- Health Connect Section -->
                <TextView
                    android:id="@+id/header_health_connect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="4dp"
                    android:text="@string/heading_health_connect"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/row_health_connect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/label_health_connect"
                    app:rowDescription="@string/desc_health_connect"
                    app:rowType="toggle"
                    app:switchId="@+id/switch_health_connect" />

                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/input_hc_min_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/label_hc_min_duration"
                    app:rowDescription="@string/desc_hc_min_duration"
                    app:rowType="value"
                    app:valueId="@+id/text_hc_min_duration_value" />

                <!-- Do Not Disturb Section -->
                <TextView
                    android:id="@+id/header_dnd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="4dp"
                    android:text="@string/heading_dnd"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Auto Sleep Timer Toggle Row -->
                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/row_auto_timer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/label_auto_timer"
                    app:rowDescription="@string/desc_auto_timer"
                    app:rowType="toggle"
                    app:switchId="@+id/switch_auto_timer" />

                <!-- Backup Section -->
                <TextView
                    android:id="@+id/header_backup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="4dp"
                    android:text="@string/heading_backup"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Export Settings Row -->
                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/btn_export"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/label_export"
                    app:rowDescription="@string/desc_export"
                    app:rowType="none" />

                <!-- Import Settings Row -->
                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/btn_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/label_import"
                    app:rowDescription="@string/desc_import"
                    app:rowType="none" />

                <!-- About Section -->
                <TextView
                    android:id="@+id/header_about"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="36dp"
                    android:paddingBottom="4dp"
                    android:text="@string/heading_about"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- Version Row -->
                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/btn_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/label_version"
                    app:rowDescription="@string/desc_version"
                    app:rowType="value"
                    app:valueId="@+id/app_version_text" />

                <!-- Feedback Row -->
                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/btn_feedback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/link_feedback"
                    app:rowDescription="@string/desc_feedback"
                    app:rowType="none" />

                <!-- Report Crash Row -->
                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/btn_report_crash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:rowTitle="@string/label_report_crash"
                    app:rowDescription="@string/desc_report_crash"
                    app:rowType="none" />

                <!-- Links Section -->
                <com.bas080.autosleepdroid.SettingRowView
                    android:id="@+id/btn_links"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:rowTitle="@string/label_links"
                    app:rowDescription="@string/desc_links"
                    app:rowType="none" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Full-screen Manual View Container -->
    <RelativeLayout
        android:id="@+id/manual_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/manual_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:text="@string/link_manual"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/btn_manual_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:text="@string/btn_back" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/manual_title_text"
            android:layout_above="@id/btn_manual_back"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/manual_text_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />
        </ScrollView>
    </RelativeLayout>

    <!-- Full-screen Logs View Container -->
    <RelativeLayout
        android:id="@+id/logs_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/logs_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:text="@string/title_activity_log"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/logs_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_clear_logs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_clear_logs" />

            <Button
                android:id="@+id/btn_logs_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_back" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/event_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/logs_title_text"
            android:layout_above="@id/logs_bottom_bar"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/event_log_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textIsSelectable="true" />
        </ScrollView>
    </RelativeLayout>

    <!-- Full-screen Feedback / Crash Report View Container -->
    <RelativeLayout
        android:id="@+id/feedback_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/windowBackground"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/feedback_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:text="@string/link_feedback"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/feedback_privacy_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/feedback_title_text"
            android:text="@string/desc_feedback_privacy_notice"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/feedback_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_discard_crash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:text="@string/btn_discard" />

            <Button
                android:id="@+id/btn_copy_feedback"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_copy" />

            <Button
                android:id="@+id/btn_send_feedback_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/btn_send_report" />

            <Button
                android:id="@+id/btn_feedback_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_back" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/feedback_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/feedback_privacy_notice"
            android:layout_above="@id/feedback_bottom_bar"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/feedback_prompt_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/prompt_feedback"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="14sp"
                    android:paddingBottom="8dp" />

                <EditText
                    android:id="@+id/feedback_text_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="5"
                    android:gravity="top|start"
                    android:hint="@string/feedback_input_hint"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textColorHint="?android:attr/textColorSecondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:inputType="textMultiLine"
                    android:importantForAutofill="no" />

                <CheckBox
                    android:id="@+id/chk_include_logs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/label_include_logs"
                    android:textColor="?android:attr/textColorPrimary"
                    android:checked="true" />
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>

</FrameLayout>